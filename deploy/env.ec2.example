# EC2(개발 서버)용 .env 템플릿 — RDS에 '직접' 붙는다(SSH 터널 아님).
# 실제 파일은 리포 루트에 `.env`로 두고 비밀번호를 채운다. git에 올리지 말 것.
#
#   scp -i bidmate-api.pem deploy/env.ec2.example ubuntu@<EC2_IP>:/home/ubuntu/bidding-agent/.env
#   그 뒤 EC2에서 nano .env 로 POSTGRES_PASSWORD 채우기.

# --- DB (프라이빗 RDS, 같은 VPC라 엔드포인트 직접) ---
POSTGRES_HOST=bidmate-postgres.cv8i80gskzwz.ap-northeast-2.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=bidmate
POSTGRES_USER=bidmaster
POSTGRES_PASSWORD=__여기_채우기__
POSTGRES_SSLMODE=require

# --- 커넥션 풀 (상시 서버라 1보다 키우되, 공유 운영 DB라 과하게 금지) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- CORS (프론트 오리진. 정해지면 콤마로 추가) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- 대화 에이전트 호출 주소 (백엔드가 읽는다) ---
# 에이전트는 별도 프로세스로 분리됐다. 백엔드는 POST {AGENT_BASE_URL}/turn을 부른다.
# ⚠ 127.0.0.1로 두면 안 된다. 백엔드는 브리지 네트워크 컨테이너라 컨테이너 자기
# 자신을 가리키게 되고, 호스트 nginx :8010(에이전트)에는 닿지 않는다. host-gateway는
# deploy-blue-green.sh의 --add-host가 심어준다.
# 로컬에서 uvicorn을 호스트에 직접 띄울 때는 http://127.0.0.1:8010 을 쓴다.
AGENT_BASE_URL=http://host.docker.internal:8010
# 선택. 에이전트 nginx(300s)·백엔드 nginx(180s)보다 짧아야 백엔드가 먼저 끊는다.
# AGENT_TIMEOUT_SEC=60

# --- 대화 에이전트(bidmate-agents) 런타임 ---
# ⚠ 아래 블록은 이제 백엔드가 아니라 '에이전트 컨테이너'가 읽는다(같은 .env 파일을
# 두 배포가 공유한다 — 에이전트 레포 deploy/CD.md의 EC2_ENV_FILE). 백엔드 컨테이너에
# 남아 있어도 무해하지만, 대화가 안 되면 고칠 곳은 에이전트 쪽이다.
# 단, OPENSEARCH_*/CF_* 는 백엔드 추천 API도 함께 쓴다.
# agents/config.py의 Settings는 필수 필드를 지연 로딩한다 — 아래가 비어 있어도
# 컨테이너는 뜨고 /health·/ready도 통과한 뒤 Blue/Green 전환까지 성공한다.
# 실제로 깨지는 시점은 첫 대화 요청이다. 배포 전에 반드시 채울 것.

# Bedrock. agents/llm.py가 os.environ에서 직접 읽어 KeyError로 죽는다(기본값 없음).
# boto3 표준 이름(AWS_ACCESS_KEY_ID)이 아니라 이 이름이어야 한다.
AWS_ACCESS_KEY=__여기_채우기__
AWS_SECRET_KEY=__여기_채우기__

# OpenSearch — 백엔드 추천 API와 에이전트 검색(C)이 같은 값을 공유한다.
OPENSEARCH_ENDPOINT=__여기_채우기__
OPENSEARCH_USER=__여기_채우기__
OPENSEARCH_PASSWORD=__여기_채우기__
OPENSEARCH_INDEX=bid_chunks
OPENSEARCH_VERIFY_CERTS=true

# PostgreSQL — 에이전트는 위 POSTGRES_* 가 아니라 PG_* 이름을 쓴다.
# 같은 RDS를 가리켜도 이름이 다르므로 두 벌 다 있어야 한다.
PG_HOST=bidmate-postgres.cv8i80gskzwz.ap-northeast-2.rds.amazonaws.com
PG_PORT=5432
PG_DATABASE=bidmate
PG_USER=bidmaster
PG_PASSWORD=__여기_채우기__
# RDS 기본은 UTC인데 bid_table 일시 컬럼은 KST naive라, 고정하지 않으면 마감
# 판정이 9시간 어긋난다.
PG_TIMEZONE=Asia/Seoul

# Cloudflare Workers AI (질의 임베딩). 색인과 반드시 같은 모델이어야 한다.
CF_ACCOUNT_ID=__여기_채우기__
CF_API_TOKEN=__여기_채우기__
CF_EMBEDDING_MODEL=@cf/baai/bge-m3
